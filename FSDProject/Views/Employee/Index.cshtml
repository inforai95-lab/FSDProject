
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<button class="btn btn-sm btn-primary m-2" id="btnAddEmployee">Add Employee</button>
<table class="table table-bordered">
    <thead>
        <tr class="text-center">
            <td>Id</td>
            <td>Name</td>
            <td>City</td>
            <td>State</td>
            <td>Salary</td>
            <td>Operation</td>
        </tr>
    </thead>
    <tbody class="text-center" id="table_data"></tbody>

</table>
<div class="modal fade modal"id="EmpId">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="text-info modal-title" id="UpdateEmp">Add Employee</h1>
                <button class="close text-danger"data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <form method="post">
                    <div class="form-group" id="divId">
                        <label>Id</label>
                        <input type="text"class="form-control" id="EmployeeId" disabled="disabled"  />
                    </div>
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" placeholder="Enter Name" class="form-control" id="Name" autocomplete="off" />
                    </div>
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" placeholder="Enter City" class="form-control" id="City" autocomplete="off" />
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <input type="text" placeholder="Enter State" class="form-control" id="State" autocomplete="off" />
                    </div>
                    <div class="form-group">
                        <label>Salary</label>
                        <input type="text" placeholder="Enter Salary" class="form-control" id="Salary" autocomplete="off" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="AddEmployee();" id="btnAdd">Sava</button>
                <button class="btn btn-warning" onclick="UpdateEmployee();" style="display:none" id="btnupdate">Update</button>
                <button class="btn btn-danger btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>

    </div>

</div>

<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/custom.js"></script>